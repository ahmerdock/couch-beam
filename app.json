{
  "expo": {
    "name": "Couch Beam",
    "slug": "couch-beam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "couchbeam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ahmerdock.couchbeam",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Couch Beam finds and controls your TV on your local network.",
        "NSBonjourServices": ["_androidtvremote2._tcp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0C0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "package": "com.ahmerdock.couchbeam"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0C0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-iap",
      "expo-font",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "owner": "ahmerdock"
  }
}
